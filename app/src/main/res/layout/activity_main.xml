<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="?attr/visaBackgroundColor"
    tools:context=".MainActivity">

    <!-- welcome message -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/temptextGood"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/greeting"
            android:textSize="15sp"
            android:textColor="?attr/visaTextGreetingColor"
            android:letterSpacing="0.08"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/topButtons"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/temptextWould"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/main_question"
            android:textSize="25sp"
            android:textColor="?attr/visaDarkColor"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/topButtons"
            app:layout_constraintTop_toBottomOf="@id/temptextGood" />

        <LinearLayout
            android:id="@+id/topButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center|end"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/temptextGood">

            <ImageView
                android:id="@+id/btnHelp"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_help"
                android:padding="2dp"
                android:contentDescription="Help" />

            <ImageView
                android:id="@+id/btnSetting"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/ic_setting"
                android:padding="2dp"
                android:contentDescription="Setting" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Screen card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardScreen"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/visaCardDarkColor">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- icon (top-right) -->
            <ImageView
                android:id="@+id/imgScreen"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="top|end"
                android:layout_margin="22dp"
                android:src="@drawable/ic_smartphone"
                android:background="@drawable/bg_icon_dark"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:tint="#F8F8F8"
                android:contentDescription="screen icon" />

            <!-- text (bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_mode_label"
                    android:textSize="20sp"
                    android:textColor="?attr/visaTextScreenColorOne"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_mode_title"
                    android:textSize="50sp"
                    android:textColor="?attr/visaTextScreenColorTwo"
                    android:singleLine="false"
                    android:maxLines="2"/>

                <TextView
                    android:id="@+id/txtScreen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/screen_mode_subtitle"
                    android:textSize="18sp"
                    android:textColor="?attr/visaTextScreenColorThree"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Camera card (white) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardCamera"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/visaCardLightColor">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/imgCamera"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="top|end"
                android:layout_margin="22dp"
                android:src="@drawable/ic_camera"
                android:background="@drawable/bg_icon_light"
                android:padding="13dp"
                android:contentDescription="camera icon" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_mode_label"
                    android:textSize="20sp"
                    android:textColor="?attr/visaTextCameraColorOne"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_mode_title"
                    android:textSize="50sp"
                    android:textColor="?attr/visaTextCameraColorTwo"
                    android:singleLine="false"
                    android:maxLines="2"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/camera_mode_subtitle"
                    android:textSize="18sp"
                    android:textColor="?attr/visaTextCameraColorThree"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- Exit btn -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardExit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="?attr/visaCardExitColor">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="18dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_exit"
                android:layout_marginEnd="8dp"
                android:contentDescription="exit" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/exit_app"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/visaTextExitColor" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>