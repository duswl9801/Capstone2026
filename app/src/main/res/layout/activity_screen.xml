<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/screen"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            app:fontFamily="@font/lexend_semibold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="SCREEN ASSISTANT"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:letterSpacing="0.05"/>

        <TextView
            android:id="@+id/helpMessage"
            app:fontFamily="@font/lexend_regular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:textColor="?attr/colorOnBackground"
            android:textSize="21sp"
            android:letterSpacing="0.05"
            android:lineSpacingExtra="4dp"
            android:text="How to use Screen Assistant&#10;&#10;Steps:&#10;1. Type what you want help with.&#10;2. Tap Start Assistant.&#10;3. Go to the app screen you need help with.&#10;4. The assistant will read the screen and guide you.&#10;5. Follow the suggestion only if you want to.&#10;&#10;The assistant does not take action without your approval.&#10;&#10;You can stop the assistant at any time."/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>