<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:background="?attr/visaBackgroundColor"
    tools:context=".SettingActivity">

    <LinearLayout
        android:id="@+id/topBackBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/back_to_menu"
            android:textSize="25sp"
            android:letterSpacing="0.05"/>
    </LinearLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/txtSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/setting_title"
        android:textSize="55sp"
        android:textColor="?attr/visaDarkColor"
        android:layout_marginBottom="30dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Language Card / Main important card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLanguage"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/visaDarkColor">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="bottom|start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GENERAL"
                            android:textSize="11sp"
                            android:textColor="#777777"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/txtLanguageTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Language"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF" />

                        <TextView
                            android:id="@+id/txtLanguageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="English"
                            android:textSize="15sp"
                            android:textColor="#AAAAAA"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iconLanguage"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_language"
                        android:background="@drawable/bg_icon_dark"
                        android:padding="8dp"
                        android:contentDescription="Language"
                        app:tint="#F8F8F8" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Voice Mode Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardVoiceMode"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/visaCardSoftColor">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center_vertical|start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INTERACTION"
                            android:textSize="11sp"
                            android:textColor="#AAAAAA"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/txtVoiceModeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voice Mode"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#111111" />

                        <TextView
                            android:id="@+id/txtVoiceModeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voice + Text combined"
                            android:textSize="15sp"
                            android:textColor="#777777"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iconVoiceMode"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_voice"
                        android:background="@drawable/bg_icon_light"
                        android:padding="9dp"
                        android:contentDescription="Voice mode"
                        app:tint="#111111" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Theme Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardTheme"
                android:layout_width="match_parent"
                android:layout_height="136dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/visaCardSoftColor">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_gravity="center_vertical|start">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="VISUAL"
                            android:textSize="11sp"
                            android:textColor="#999999"
                            android:letterSpacing="0.12"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/txtThemeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Theme"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#111111" />

                        <TextView
                            android:id="@+id/txtThemeValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Default (Light)"
                            android:textSize="15sp"
                            android:textColor="#777777"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iconTheme"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="top|end"
                        android:src="@drawable/ic_theme"
                        android:background="@drawable/bg_icon_light"
                        android:padding="9dp"
                        android:contentDescription="Theme"
                        app:tint="#111111" />

                </FrameLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>