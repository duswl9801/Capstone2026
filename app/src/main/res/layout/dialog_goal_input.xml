<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/dialogContainer"
        android:background="@drawable/bg_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/titleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/dialogTitle"
                app:fontFamily="@font/lexend_semibold"
                android:textColor="@color/visa_brown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="What do you want to do?"
                android:textSize="30sp" />

            <ImageView
                android:id="@+id/btnSpeak"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:minWidth="60dp"
                android:src="@drawable/ic_speaker"
                app:tint="@color/visa_orange"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Read this message" />
        </LinearLayout>

        <TextView
            android:id="@+id/dialogMessage"
            app:fontFamily="@font/lexend_regular"
            android:textColor="@color/visa_brown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Type your goal for this screen. I will look at the screen and suggest the next action."
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <EditText
            android:id="@+id/editGoal"
            app:fontFamily="@font/lexend_regular"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_goal_input"
            android:gravity="top|start"
            android:hint="Example: I want to refill my prescription"
            android:textColorHint="#B8B0A6"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="@color/visa_brown"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCancel"
                android:background="@drawable/bg_suggestion_second_btn"
                app:fontFamily="@font/lexend_semibold"
                android:textColor="@color/visa_taupe"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Cancel"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="20dp"
                android:layout_height="match_parent" />


            <TextView
                android:id="@+id/btnOk"
                android:background="@drawable/bg_suggestion_first_btn"
                app:fontFamily="@font/lexend_semibold"
                android:textColor="@color/white"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="OK"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>