<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/dialogContainer"
        android:background="@drawable/bg_dialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="10dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp">

        <LinearLayout
            android:id="@+id/titleRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/dialogTitle"
                app:fontFamily="@font/lexend_semibold"
                android:textColor="?attr/visaTextDarkSoftColor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/goal_dialog_title"
                android:textSize="30sp" />

            <ImageView
                android:id="@+id/btnSpeak"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:minWidth="60dp"
                android:src="@drawable/ic_speaker"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Read this message" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/dialogMessage"
            app:fontFamily="@font/lexend_regular"
            android:textColor="?attr/visaTextDarkSoftColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/goal_dialog_body"
            android:textSize="20sp"
            android:lineSpacingExtra="4dp" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/editGoal"
            app:fontFamily="@font/lexend_regular"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_goal_input"
            android:gravity="top|start"
            android:hint="@string/goal_dialog_hint"
            android:textColorHint="?attr/visaTextDarkSoftHintColor"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="3"
            android:padding="14dp"
            android:textColor="?attr/visaTextDarkSoftColor"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/buttonRow"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnCancel"
                android:background="@drawable/bg_square_secondary_button"
                app:fontFamily="@font/lexend_semibold"
                android:textColor="?attr/visaBtnMainColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/cancel"
                android:textSize="22sp" />

            <View
                android:layout_width="20dp"
                android:layout_height="match_parent" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/btnOk"
                android:background="@drawable/bg_square_button"
                app:fontFamily="@font/lexend_semibold"
                android:textColor="?attr/visaBtnTextColor"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/ok"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>